# Packages for macOS, installed with `brew bundle` by install.sh
# zsh and git ship with macOS.

# dotfiles tooling
brew "stow"
brew "gh"

# shell and terminal
brew "tmux"
# Skipped when kitty was installed by hand, which would make brew bundle fail
cask "kitty" unless File.exist?("/Applications/kitty.app")

# editor and the search tools it uses
brew "neovim"
brew "tree-sitter-cli"
brew "ripgrep"
brew "fd"
brew "fzf"
brew "fnm"

# fonts
cask "font-iosevka-nerd-font"
cask "font-jetbrains-mono-nerd-font"

# desktop
cask "maccy"        # clipboard history (Shift+Cmd+C)
# Tiling window manager and its window borders, the macOS side of Hyprland.
# Third-party taps: newer Homebrew may ask you to trust them first (brew trust ...)
tap "nikitabobko/tap"
tap "felixkratz/formulae"
cask "nikitabobko/tap/aerospace"
brew "felixkratz/formulae/borders"
