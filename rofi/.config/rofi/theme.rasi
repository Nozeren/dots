/* Shared look of every rofi popup (launcher, power menu, clipboard). Colours: colors.rasi (Everforest). */
@import "colors.rasi"

* {
    font: "Iosevka Nerd Font 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    padding: 8px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: @bg-alt;
}
prompt {
    text-color: @accent;
}
entry {
    placeholder: "Search…";
    placeholder-color: @fg-dim;
    cursor: text;
}

listview {
    fixed-height: false;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 7px 10px;
    spacing: 10px;
    border-radius: 10px;
}
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}
element selected.normal {
    background-color: @sel-bg;
    text-color: @sel-fg;
}
element-icon {
    size: 32px;
}
element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
