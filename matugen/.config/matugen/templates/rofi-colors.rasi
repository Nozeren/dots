/* Generated by matugen from the wallpaper */
* {
    bg:     {{colors.surface_container.default.hex}};
    bg-alt: {{colors.surface_container_high.default.hex}};
    fg:     {{colors.on_surface.default.hex}};
    fg-dim: {{colors.outline.default.hex}};
    accent: {{colors.primary.default.hex}};
    sel-bg: {{colors.primary_container.default.hex}};
    sel-fg: {{colors.on_primary_container.default.hex}};
    border: {{colors.outline_variant.default.hex}};
}
